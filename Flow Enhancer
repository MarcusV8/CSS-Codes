                const el = $qs(selector, doc);
                if (el) { obs.disconnect(); clearTimeout(timer); resolve(el); }
            });
            obs.observe(doc.body, { childList: true, subtree: true });
            timer = setTimeout(() => { obs.disconnect(); resolve(null); }, timeout || 6000);
        });
